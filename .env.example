# MCP Screenshot Server Configuration
# Copy this file to .env and adjust settings as needed

# Security Settings
MCP_BLOCK_PRIVATE_NETWORKS=true   # SSRF guard. Set to false ONLY to screenshot localhost
MCP_ALLOWED_OUTPUT_DIR=./shots    # Directory where screenshots can be saved
MCP_MAX_TIMEOUT=60000             # Maximum timeout in milliseconds

# Browser Settings
MCP_HEADLESS=new                  # Puppeteer headless mode ('new' or true/false)

# Logging
LOG_LEVEL=info                    # Options: error, warn, info, debug, trace
